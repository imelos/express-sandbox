{
  "name": "express-sandbox",
  "version": "1.0.0",
  "description": "Express backend for localized UI translations with ETag sync",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "admin:create": "node src/scripts/createAdminUser.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.8.0"
  },
  "bin": {
    "create-admin-user": "src/scripts/createAdminUser.js"
  }
}
